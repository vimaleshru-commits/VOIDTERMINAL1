import os
import time
import random

USER_FILE="user.txt"
TASK_FILE="tasks.txt"
CONFIG_FILE="config.txt"

def fake_buttons(title, options):
    index = 0
    while True:
        clear()
        print("==", title, "==\n")

        for i,o in enumerate(options):
            if i == index:
                print(">>", o)
            else:
                print("  ", o)

        print("\nType number or press Enter")
        for i,o in enumerate(options):
            print(str(i), "-", o)

        k = input("> ").lower()

        if k.isdigit():
            n = int(k)
            if 0 <= n < len(options):
                return options[n]

        if k == "":
            return options[index]


# ---------------- BASIC IO CHAOS ----------------

def save_data(p,d):
    try:
        f=open(p,"w")
        f.write(str(d))
        f.close()
    except:
        pass

def load_data(p):
    if not os.path.exists(p):
        return {}
    try:
        return eval(open(p).read())
    except:
        return {}

def clear():
    os.system("cls" if os.name=="nt" else "clear")

# ---------------- LOAD CORE ----------------

user=load_data(USER_FILE)
tasks=load_data(TASK_FILE)
config=load_data(CONFIG_FILE)

if not isinstance(user,dict): user={}
if not isinstance(tasks,dict): tasks={}
if not isinstance(config,dict): config={}

if "xp" not in user: user["xp"]=0
if "level" not in user: user["level"]=1

inventory=[]
history=[]
achievements=[]
skills={"focus":0,"logic":0,"speed":0}

roasts=[
"bro wake up",
"npc behavior",
"future you disappointed",
"skill issue",
"keyboard warrior"
]

mini_ai={
"hello":["yo","sup"],
"sad":["damn","stay strong"],
"tired":["drink water"],
"motivation":["keep pushing"]
}

# ---------------- LOGIN ----------------

def login():
    if "pass" not in user:
        user["pass"]=input("Create password: ")
        save_data(USER_FILE,user)
    p=input("Password: ")
    if p!=user["pass"]:
        print("wrong")
        exit()

def create_user():
    if "name" not in user:
        user["name"]=input("Name: ")
        save_data(USER_FILE,user)

# ---------------- XP SYSTEM ----------------

def give_xp(x):
    user["xp"]+=x
    if user["xp"]>=user["level"]*100:
        user["xp"]=0
        user["level"]+=1
        print("LEVEL UP:",user["level"])
    save_data(USER_FILE,user)

# ---------------- TASKS ----------------

def add_task():
    t=input("Task: ")
    i=str(len(tasks)+1)
    tasks[i]={"text":t,"done":False}
    save_data(TASK_FILE,tasks)
    give_xp(10)

def show_tasks():
    for k in tasks:
        mark="✓" if tasks[k]["done"] else " "
        print(k,"[",mark,"]",tasks[k]["text"])

def complete_task():
    i=input("ID: ")
    if i in tasks:
        tasks[i]["done"]=True
        save_data(TASK_FILE,tasks)
        give_xp(25)

# ---------------- MINI GAME ----------------

def play_game():
    n=random.randint(1,50)
    while True:
        g=input("Guess(q): ")
        if g=="q": break
        if not g.isdigit():
            print("number pls")
            continue
        g=int(g)
        if g==n:
            print("you win")
            give_xp(50)
            break
        elif g<n:
            print("higher")
        else:
            print("lower")

# ---------------- CHAT AI ----------------

def ai_reply(text):
    for k in mini_ai:
        if k in text:
            print(random.choice(mini_ai[k]))
            return True
    return False

# ---------------- INVENTORY ----------------

def add_item(cmd):
    inventory.append(cmd.replace("get",""))
    print("item added")

def show_inventory():
    for i in inventory:
        print("-",i)

# ---------------- BOSS ----------------

def fight_boss():
    hp=100
    while hp>0:
        print("BOSS HP:",hp)
        c=input("attack/run: ")
        if c=="attack":
            d=random.randint(10,30)
            hp-=d
            print("hit",d)
        else:
            return
    print("BOSS DEFEATED")
    achievements.append("First Blood")
    skills["logic"]+=1

# ---------------- SANDBOX ----------------

def sandbox():
    print("SANDBOX MODE | type help | exit to leave")
    while True:
        c=input("sandbox>>> ")
        if c=="exit":
            break

        if c=="help":
            print("""
help            - show this menu
vars            - show live variables
clear           - clear screen
math            - calculator mode
back            - same as exit
""")
            continue

        if c=="vars":
            print("user =",user)
            print("tasks =",tasks)
            print("inventory =",inventory)
            print("skills =",skills)
            print("achievements =",achievements)
            continue

        if c=="clear":
            clear()
            continue

        if c=="math":
            while True:
                m=input("math>>> ")
                if m=="exit":
                    break
                try:
                    print(eval(m))
                except:
                    print("math error")
            continue

        if c=="back":
            break

        try:
            exec(c)
        except Exception as e:
            print("error:",e)


