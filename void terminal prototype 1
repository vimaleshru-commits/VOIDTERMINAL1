# ---------------- STARTUP ----------------

clear()
login()
create_user()

print("WELCOME",user["name"])
print("Level:",user["level"],"XP:",user["xp"])

# ---------------- MAIN LOOP ----------------

while True:
    cmd=input(">>> ").lower()
    history.append(cmd)

    if len(history)>25:
        history.pop(0)

    if ai_reply(cmd):
        continue

    if cmd=="help":
        show_help()

    elif cmd == "menu":
        choice = fake_buttons("MAIN MENU", [
            "Tasks",
            "Add Task",
            "Play Game",
            "Inventory",
            "Stats",
            "Boss Fight",
            "Exit"
        ])

        if choice == "Tasks":
            show_tasks()
        elif choice == "Add Task":
            add_task()
        elif choice == "Play Game":
            play_game()
        elif choice == "Inventory":
            show_inventory()
        elif choice == "Stats":
            print("Level:", user["level"], "XP:", user["xp"])
        elif choice == "Boss Fight":
            fight_boss()
        elif choice == "Exit":
            break

    elif cmd=="addtask":
        add_task()

    elif cmd=="tasks":
        show_tasks()

    elif cmd=="done":
        complete_task()

    elif cmd=="play":
        play_game()

    elif cmd.startswith("get"):
        add_item(cmd)

    elif cmd=="inventory":
        show_inventory()

    elif cmd=="history":
        for h in history:
            print(h)

    elif cmd=="plan":
        for k in list(tasks)[:5]:
            print("-",tasks[k]["text"])

    elif cmd=="sandbox":
        sandbox()

    elif cmd=="stats":
        print("Level:",user["level"],"XP:",user["xp"])

    elif cmd=="boss":
        fight_boss()

    elif cmd=="roast":
        print(random.choice(roasts))

    elif cmd=="exit":
        save_data(USER_FILE,user)
        save_data(TASK_FILE,tasks)
        save_data(CONFIG_FILE,config)
        break

    else:
        print("unknown command")
        print(random.choice(roasts))
